# Copy to .env.local and fill with real values.
# NEVER commit .env.local — it holds live secrets.

# Supabase (https://supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Inngest (https://inngest.com → your app → Environment)
INNGEST_EVENT_KEY=<event-key>
INNGEST_SIGNING_KEY=<signing-key>

# Local dev: route events to the local dev server instead of Inngest Cloud
INNGEST_DEV=true

# App origin (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Figma OAuth (https://www.figma.com → Settings → Security)
FIGMA_CLIENT_ID=<client-id>
FIGMA_CLIENT_SECRET=<client-secret>
# Optional: personal access token fallback (single-account demo)
FIGMA_ACCESS_TOKEN=<pat>

# Vision (optional; image mode degrades gracefully without it)
# VISION_PROVIDER=openrouter        # or "gemini", or "opencode" for MiMo via opencode zen
# GEMINI_API_KEY=<google-ai-studio-key>
# VISION_MODEL=gemini-2.5-flash     # or "mimo-v2.5-free" — ignored for "openrouter" (uses its own free-model fallback list)
# OPENCODE_GO_API_KEY=<opencode-go-key>
# OPENROUTER_API_KEY=<openrouter-key>   # free tier, no paid account needed — see OPENROUTER_FREE_VISION_MODELS in src/lib/vision.ts

# Fast accessibility preview (optional; audit works fully without it) —
# Google PageSpeed Insights API (runs Lighthouse server-side). Get a key at
# https://console.cloud.google.com/apis/credentials after enabling the
# "PageSpeed Insights API" (NOT the Chrome UX Report / CrUX API — that is a
# different API with no accessibility data).
# GOOGLE_PAGESPEED_API_KEY=<google-cloud-api-key>

# Android APK analysis (optional — aapt2 from Android SDK build-tools)
# AAPT2_PATH=C:/Users/<you>/AppData/Local/Android/Sdk/build-tools/<ver>/aapt2.exe

# Tuning (optional)
# MAX_PAGES=5
# ANON_DAILY_LIMIT=5
# AUDIT_RETENTION_HOURS=24
# FIGMA_TOKEN_TTL_HOURS=24

# Google Analytics (optional; site works fully without it)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
