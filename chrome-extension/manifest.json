{
  "manifest_version": 3,
  "name": "ScanA11y — Accessibility Auditor",
  "version": "2.0.1",
  "description": "Audit the current tab against WCAG 2.2 (axe-core), inspect any element's role/name/contrast, and apply on-page accessibility options — all local, no account, no history stored.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "dist/index.html"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "minimum_chrome_version": "116"
}
